struct Game {
    x: float,
    y: float,
    vel_y: float,
}

fn update(mut g: Game, win: int) -> int {
    g.vel_y = g.vel_y + 0.65
    g.y = g.y + g.vel_y
    if g.y > 500.0 {
        g.y = 500.0
        g.vel_y = 0.0
    }
    if key_down(win, 1) == 1 {
        g.x = g.x - 6.0
    }
    if key_down(win, 2) == 1 {
        g.x = g.x + 6.0
    }
    if key_down(win, 5) == 1 {
        g.vel_y = 0 - 14.5
    }
    g.x = clamp_val(g.x, 0, 750)
    clear(win, 1974826)
    draw_rect(win, g.x, g.y, 50, 50, 14707829)
    return 0
}
