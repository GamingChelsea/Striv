fn fill_rect(mut buf: Vec, x0: int, y0: int, w: int, h: int, color: int) {
    for y in y0..y0 + h {
        if y > 0 {
            if y < 600 {
                for x in x0..x0 + w {
                    if x > 0 {
                        if x < 800 {
                            buf[y * 800 + x] = color
                        }
                    }
                }
            }
        }
    }
}

fn main() -> int {
    let opts = WindowOptions::default()
    let mut win = Window::new("100% Auto Bindgen Striv!", 800, 600, opts)
    let mut buf = []
    for i in 0..480000 {
        buf.push(0x1E222A)
    }
    let mut px = 375
    let mut py = 275
    let color = 0x61AFEF
    while win.is_open() {
        if win.is_key_down(Key::Escape) {
            return 0
        }
        if win.is_key_down(Key::Left) {
            px -= 8
        }
        if win.is_key_down(Key::Right) {
            px += 8
        }
        if win.is_key_down(Key::Up) {
            py -= 8
        }
        if win.is_key_down(Key::Down) {
            py += 8
        }
        fill_rect(buf, 0, 0, 800, 600, 0x1E222A)
        fill_rect(buf, px, py, 50, 50, color)
        win.update_with_buffer(buf, 800, 600)
    }
    return 0
}
