{
  "name": "striv-vscode",
  "displayName": "Striv Support",
  "publisher": "local",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "activationEvents": [
    "onLanguage:striv"
  ],
  "main": "./extension.js",
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  },
  "contributes": {
    "languages": [
      {
        "id": "striv",
        "aliases": ["Striv", "striv"],
        "extensions": [".strv"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "striv",
        "scopeName": "source.striv",
        "path": "./syntaxes.json"
      }
    ]
  }
}
