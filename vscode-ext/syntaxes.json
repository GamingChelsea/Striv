{
  "scopeName": "source.striv",
  "patterns": [
    { "match": "//.*$", "name": "comment.line.double-slash" },
    {
      "begin": "\"",
      "end": "\"",
      "name": "string.quoted.double.striv",
      "patterns": [
        { "match": "\\\\.", "name": "constant.character.escape.striv" },
        {
          "begin": "\\{",
          "end": "\\}",
          "name": "meta.embedded.expression.striv",
          "contentName": "source.striv"
        }
      ]
    },
    {
      "match": "\\b(unit)\\s+([a-zA-Z_][a-zA-Z0-9_]*)\\b",
      "captures": {
        "1": { "name": "keyword.control" },
        "2": { "name": "entity.name.type" }
      }
    },
    { "match": "\\b(use|import|fn|proc|enum|open|extend|match|let|mut|if|else|while|for|in|return|break|continue|struct|impl|print|tweak|const|unit|defer|concurrent|spawn|shared|lock|parallel|query|select|timeout|rpc|sync|rust|extern|foreign|test|assert|true|false|null|Ok|Err|Some|None)\\b", "name": "keyword.control" },
    { "match": "\\b(int|float|f32|i32|u32|u8|i8|bool|String|cstr|Vec|Bytes|Deque|Map|StrMap|BTree|Set|Heap|Grid|BitSet|Channel|Atomic|Ecs|Mods|entity)\\b", "name": "storage.type" },
    { "match": "\\b[A-Z][a-zA-Z0-9_]*\\b", "name": "entity.name.type" },
    { "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*\\()", "name": "entity.name.function" },
    { "match": "\\b0x[0-9a-fA-F]+\\b", "name": "constant.numeric.hex" },
    { "match": "\\b[0-9][0-9_]*(\\.[0-9][0-9_]*)?([eE][+-]?[0-9][0-9_]*)?\\b", "name": "constant.numeric.float" }
  ]
}
